# SAMEPLZ 환경 변수 목록 (값 없음, 이름만)
#
# 파일 이름이 ".env.example"이 아닌 이유: .claude/settings.json 이 Read(./.env.*)를 거부하므로
# ".env.example"은 Claude가 읽지 못한다. 이 파일을 복사해 .env.local 을 만들고 값은 직접 넣는다.
#   cp env.example .env.local
# 운영·프리뷰 값은 Vercel 환경 변수와 Supabase→Vercel 연동이 넣는다. .env 파일을 커밋하지 않는다.
#
# 규칙: NEXT_PUBLIC_* 는 브라우저로 간다. secret 값에 NEXT_PUBLIC_ 를 붙이지 않는다.

# --- 사이트 ---
NEXT_PUBLIC_SITE_URL=

# --- Supabase (새 키 체계: sb_publishable_… / sb_secret_…) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- 토스페이먼츠 (결제위젯 · 확인 API · 웹훅 · 지급대행) ---
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_PAYOUT_SECURITY_KEY=
TOSS_WEBHOOK_SECRET=

# --- PortOne (본인인증만) ---
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_IDENTITY_CHANNEL_KEY=
PORTONE_API_SECRET=

# --- 생성 공급자 (mock | fal | replicate) ---
GENERATION_PROVIDER=mock
FAL_KEY=
# fal 계정 user id: 웹훅 서명 헤더(x-fal-webhook-user-id)와 대조한다. 운영에서는 없으면 fal 웹훅을 받지 않는다.
FAL_USER_ID=
REPLICATE_API_TOKEN=
REPLICATE_WEBHOOK_SECRET=
GENERATION_WEBHOOK_BASE_URL=

# --- 모더레이션 ---
OPENAI_API_KEY=

# --- 로그인 (D4-B 선택 시) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 알림 ---
RESEND_API_KEY=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
KAKAO_PFID=

# --- 크론 ---
CRON_SECRET=

# --- 관측·분석 ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- 하네스 / 테스트 ---
# stop-verify 훅을 건너뛴다(claude -p 자동화용). 평소에는 비워 둔다.
SAMEPLZ_SKIP_STOP_VERIFY=

# --- MCP 전용 (셸 환경 변수로 둔다. .env.local 에 두지 않는다) ---
# CONTEXT7_API_KEY=
